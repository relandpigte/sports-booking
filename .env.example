# Copy to `.env` and fill in real values.

# Postgres connection string (Neon, Supabase, RDS, or local Postgres).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pikoleros?schema=public"

# Auth.js session signing secret. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=""

# Default admin account created by `npm run db:seed` (optional).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# --- Billing -----------------------------------------------------------------
# Which payment gateway to use. "fake" takes no money and approves instantly —
# it exercises the whole flow (tokenize, charge, e-wallet redirect, webhook)
# without an account or API keys. Swapping to a real gateway is one new file.
PAYMENT_PROVIDER="fake"

# HMAC secret for verifying payment webhooks. Generate with:
#   openssl rand -base64 32
# Required in production; dev falls back to an insecure default.
BILLING_WEBHOOK_SECRET=""

# Bearer token for POST /api/billing/sweep, which advances due subscriptions.
# Point a cron at that route in production. Without a value the route refuses.
BILLING_SWEEP_SECRET=""

# --- Players paying venues ---------------------------------------------------
# Encrypts partner gateway credentials at rest. Generate with:
#   node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
# Required to connect a gateway — without it, connecting REFUSES rather than
# storing a secret in plaintext. Losing this key just means partners reconnect.
ENCRYPTION_KEY=""

# Optional, for key rotation: comma-separated old keys, same "id:base64" shape.
# Rows written with an old key keep decrypting and are re-encrypted on write.
ENCRYPTION_KEYS_PREVIOUS=""

# Public origin, e.g. https://bunal.ph. Needed now that a payment redirect
# leaves the site and comes back, and to build each partner's webhook URL.
#
# PayMongo only delivers webhooks to a public https origin, so connecting a
# real PayMongo account requires this to be one — localhost will be refused at
# connect time with a message saying so. Local development uses the simulated
# gateway, which is offered in the partner's gateway list outside production.
APP_URL="http://localhost:3000"

# Bearer token for POST /api/bookings/sweep, which expires lapsed booking holds.
# Availability is correct without this ever running — it is hygiene only.
BOOKING_SWEEP_SECRET=""

# Google Maps (optional) — enables address autocomplete + map pinning on hubs.
# Create a key in Google Cloud and enable: Maps JavaScript API,
# Places API (New), Geocoding API, Maps Embed API. Restrict it by HTTP referrer.
# Without a key, hubs fall back to a plain address text field.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
