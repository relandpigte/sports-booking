# Copy to `.env` and fill in real values.

# Postgres connection string (Neon, Supabase, RDS, or local Postgres).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pikoleros?schema=public"

# Auth.js session signing secret. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth login. Create a Web application OAuth client in Google Cloud
# and authorize these redirect URIs (adjust the production domain as needed):
#   http://localhost:3000/api/auth/callback/google
#   https://www.bunal.club/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Password-reset email delivery through Resend. Verify a sending domain in
# Resend, then use an address on that domain (a subdomain is recommended).
RESEND_API_KEY=""
EMAIL_FROM="Bunal.club <accounts@bunal.club>"

# DUPR Partner API (optional). Request partner credentials and the
# CLUB_MEMBER_INFO::VIEW permission from DUPR. Use the production API base URL
# supplied during onboarding; do not put these values in NEXT_PUBLIC_* vars.
DUPR_API_BASE_URL=""
DUPR_CLIENT_KEY=""
DUPR_CLIENT_SECRET=""
DUPR_CLUB_ID=""

# Default admin account created by `npm run db:seed` (optional).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# --- Players paying venues ---------------------------------------------------
# Encrypts PayMongo credentials and authenticator MFA secrets at rest. Generate with:
#   node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
# Required to connect a gateway or enable MFA. Without it, those operations
# refuse rather than storing secrets in plaintext. Back it up securely.
ENCRYPTION_KEY=""

# Optional, for key rotation: comma-separated old keys, same "id:base64" shape.
# Rows written with an old key keep decrypting and are re-encrypted on write.
ENCRYPTION_KEYS_PREVIOUS=""

# MFA is always mandatory for administrators. To require it for partners after
# a rollout date, set this to an ISO timestamp. If omitted or invalid, partner
# MFA remains optional; partners who enable it still use it on every sign-in.
PARTNER_MFA_REQUIRED_AFTER=""

# Public origin, e.g. https://www.bunal.club. Needed now that a payment redirect
# leaves the site and comes back, and to build each partner's webhook URL.
#
# PayMongo only delivers webhooks to a public https origin, so this must be one
# — localhost is refused at connect time with a message saying so. Local
# development needs a tunnel (ngrok, cloudflared) pointed here.
APP_URL="http://localhost:3000"

# Bearer token for POST /api/bookings/sweep, which expires lapsed booking holds.
# Availability is correct without this ever running — it is hygiene only.
BOOKING_SWEEP_SECRET=""

# Optional VAT-inclusive QR Ph processing rate used to gross up direct Payment
# Intents. The default is PayMongo's published 1.34% plus 12% VAT (0.015008).
# Set this when the connected venue accounts have negotiated pricing.
PAYMONGO_QRPH_PROCESSING_RATE="0.015008"

# --- Partners paying Bunal.club ---------------------------------------------
# Optional legacy fallback for Bunal.club's own PayMongo account. Admins should
# normally connect it from Dashboard → Payment setup; this keeps deployment
# secrets out of routine account changes. Used only until the dashboard has a
# PlatformGateway row.
PAYMONGO_SECRET_KEY=""

# Optional signing-secret fallback for the environment key above. Dashboard
# setup registers and stores its own encrypted webhook secret automatically.
BILLING_WEBHOOK_SECRET=""

# Shown to partners beside the service-fee settlement form. Include the admin
# payment channel and account details as a fallback, but never an API secret.
SERVICE_FEE_PAYMENT_INSTRUCTIONS="Transfer to the Bunal.club admin account, then enter the payment reference and upload the receipt."

# Optional Google Search Console HTML-tag verification token. Prefer verifying
# the whole bunal.club domain with a DNS TXT record when possible.
GOOGLE_SITE_VERIFICATION=""

# Google Maps (optional) — enables address autocomplete + map pinning on hubs.
# Create a key in Google Cloud and enable: Maps JavaScript API,
# Places API (New), Geocoding API, Maps Embed API. Restrict it by HTTP referrer.
# Without a key, hubs fall back to a plain address text field.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
