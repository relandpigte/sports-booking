# Copy to `.env` and fill in real values.

# Postgres connection string (Neon, Supabase, RDS, or local Postgres).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pikoleros?schema=public"

# Auth.js session signing secret. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=""

# Default admin account created by `npm run db:seed` (optional).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# --- Billing -----------------------------------------------------------------
# Which payment gateway to use. "fake" takes no money and approves instantly —
# it exercises the whole flow (tokenize, charge, e-wallet redirect, webhook)
# without an account or API keys. Swapping to a real gateway is one new file.
PAYMENT_PROVIDER="fake"

# HMAC secret for verifying payment webhooks. Generate with:
#   openssl rand -base64 32
# Required in production; dev falls back to an insecure default.
BILLING_WEBHOOK_SECRET=""

# Bearer token for POST /api/billing/sweep, which advances due subscriptions.
# Point a cron at that route in production. Without a value the route refuses.
BILLING_SWEEP_SECRET=""

# Google Maps (optional) — enables address autocomplete + map pinning on hubs.
# Create a key in Google Cloud and enable: Maps JavaScript API,
# Places API (New), Geocoding API, Maps Embed API. Restrict it by HTTP referrer.
# Without a key, hubs fall back to a plain address text field.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
