// Prisma schema for Bunal.ph
// Models follow the Auth.js (NextAuth) Prisma adapter conventions, extended
// with the player-profile fields captured during registration.
// Docs: https://authjs.dev/getting-started/adapters/prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PLAYER
  PARTNER
}

model User {
  id             String    @id @default(cuid())
  name           String?
  playerName     String?
  email          String    @unique
  emailVerified  DateTime?
  phone          String?
  image          String?
  passwordHash   String?
  role           Role      @default(PLAYER)
  skillLevel     String    @default("intermediate")
  privateProfile Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  hubs           Hub[]
  bookings       Booking[]
  subscription   Subscription?
  payments       Payment[]
  paymentMethods SavedPaymentMethod[]

  partnerGateway  PartnerGateway?
  bookingPayments BookingPayment[] @relation("PlayerBookingPayments")
  venuePayments   BookingPayment[] @relation("PartnerBookingPayments")
}

// --- Billing -----------------------------------------------------------------
// Partners pay monthly to keep their hubs listed and taking bookings. Tiers are
// gated on the TOTAL number of courts across all of a partner's hubs; hubs
// themselves are unlimited on every tier.

enum PlanKey {
  STARTER
  PRO
  ELITE
}

// TRIALING  — free trial running, no charge taken.
// ACTIVE    — paid through currentPeriodEnd.
// PAST_DUE  — payment owed; access survives until graceEndsAt.
// UNPAID    — grace elapsed. No access. Nothing deleted.
// CANCELLED — cancelled and the period ran out. No access.
//
// Cancelling mid-period leaves the row ACTIVE with cancelAtPeriodEnd=true, so
// CANCELLED always means "no access" and the entitlement predicate never has to
// special-case it.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  UNPAID
  CANCELLED
}

enum PaymentMethodType {
  CARD
  GCASH
  MAYA
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentKind {
  SUBSCRIPTION // an automatic renewal charge
  MANUAL // the partner pressed "Pay now"
  COMP // comped/backfilled period, amount 0
}

// Plans live in the database rather than in constants so pricing can change
// without a deploy, and so a Payment can reference the plan it actually bought.
model Plan {
  id           String  @id @default(cuid())
  key          PlanKey @unique
  name         String
  blurb        String?
  priceMonthly Decimal @db.Decimal(10, 2)
  currency     String  @default("PHP")
  // null = unlimited. Counted across ALL of the partner's hubs.
  maxCourts    Int?
  sortOrder    Int     @default(0)
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  payments      Payment[]
}

// One row per partner, mutated through its lifecycle. History lives in Payment.
//
// There is deliberately NO price column here: the amount is always read from
// plan.priceMonthly at charge time and snapshotted onto Payment.amount. A copy
// here could only ever drift out of sync with the plan.
model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  planId String

  status    SubscriptionStatus @default(TRIALING)
  // How the partner intends to pay. CARD is the only method that auto-renews.
  method    PaymentMethodType
  // True only when method=CARD AND a live SavedPaymentMethod exists. This flag
  // is the mechanical guarantee that GCash/Maya are never silently re-charged:
  // the renewal path is a no-op unless it is set.
  autoRenew Boolean            @default(false)

  trialEndsAt        DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  // Set when entering PAST_DUE. Access survives until this instant.
  graceEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  cancelledAt        DateTime?

  // Card dunning. Reset on every successful charge.
  renewalAttempts Int       @default(0)
  nextRetryAt     DateTime?

  // Optimistic-concurrency guard for the lazy state machine. Every transition is
  // updateMany({ where: { id, version } }) asserting count === 1, so two requests
  // crossing the same deadline can't both apply it.
  version Int @default(0)

  // Diagnostic only — never used as a correctness guard.
  lastEvaluatedAt DateTime?

  // --- gateway seam (nullable now, filled by a real provider later) ---------
  provider               String  @default("fake")
  providerCustomerId     String?
  providerSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([status, currentPeriodEnd])
  @@index([status, trialEndsAt])
  @@index([status, graceEndsAt])
}

// A saved card. Separate from Subscription because a card has its own lifecycle
// (added, replaced, expires, detached) and e-wallets have no token at all —
// folding it in would mean nullable card columns that apply to one method of three.
model SavedPaymentMethod {
  id        String            @id @default(cuid())
  userId    String
  type      PaymentMethodType
  isDefault Boolean           @default(false)

  // Display only. The card number and CVC are never persisted, never logged,
  // and never echoed back into a form's values.
  brand    String?
  last4    String?
  expMonth Int?
  expYear  Int?

  // --- gateway seam ---------------------------------------------------------
  provider           String  @default("fake")
  providerCustomerId String?
  providerMethodId   String?

  createdAt DateTime  @default(now())
  // Soft delete: a historical Payment may still reference this row.
  deletedAt DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId, deletedAt])
}

model Payment {
  id             String @id @default(cuid())
  subscriptionId String
  // Denormalized like Booking.hubId — the history list and the ownership check
  // shouldn't need a join.
  userId         String
  planId         String

  kind     PaymentKind       @default(SUBSCRIPTION)
  amount   Decimal           @db.Decimal(10, 2)
  currency String            @default("PHP")
  method   PaymentMethodType
  status   PaymentStatus     @default(PENDING)

  // The period this payment buys, set at creation so a SUCCEEDED payment can
  // extend the subscription idempotently even if success arrives by webhook
  // minutes later.
  periodStart DateTime
  periodEnd   DateTime

  // THE double-charge guard: `${subscriptionId}:${periodEnd.toISOString()}:${attempt}`.
  // Two requests crossing the same renewal deadline compute the same key; the
  // loser gets P2002 and applies the winner's outcome instead of charging twice.
  // A retry after a FAILED payment increments attempt, so real retries still work.
  // Same idea as BookingSlot's unique index.
  idempotencyKey String @unique

  savedPaymentMethodId String?

  // --- gateway seam ---------------------------------------------------------
  providerPaymentId String?
  providerClientKey String?
  redirectUrl       String? @db.Text
  providerRef       String?
  failureCode       String?
  failureMessage    String? @db.Text
  raw               Json?

  paidAt         DateTime?
  refundedAt     DateTime?
  refundedAmount Decimal?  @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription       Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               Plan                @relation(fields: [planId], references: [id])
  savedPaymentMethod SavedPaymentMethod? @relation(fields: [savedPaymentMethodId], references: [id])

  @@index([subscriptionId, createdAt])
  @@index([userId, createdAt])
  @@index([status, subscriptionId])
}

// --- Players paying venues ---------------------------------------------------
// A SECOND, separate money flow from the subscription above. There, partners pay
// the platform. Here, players pay partners through the partner's OWN gateway
// account, and the platform takes nothing and never touches the funds.

// One row per PARTNER ACCOUNT, shared by every hub they own.
model PartnerGateway {
  id       String @id @default(cuid())
  userId   String @unique
  provider String @default("fake")

  // Publishable key — not a secret, safe to render.
  publicKey String

  // AES-256-GCM ciphertext (src/lib/crypto.ts). NEVER selected into a view
  // type, NEVER logged, NEVER echoed back into form state.
  secretKeyEnc     String @db.Text
  webhookSecretEnc String @db.Text
  // Last few characters of the secret, so the UI can show "sk_test_…9f2a"
  // without ever decrypting anything.
  secretKeyHint    String

  // The unguessable path segment of THIS partner's webhook URL. Random bytes,
  // deliberately not the user id — this string gets pasted into a third
  // party's dashboard.
  webhookToken String @unique

  accountLabel   String?
  connectedAt    DateTime  @default(now())
  // Disconnecting keeps the ciphertext, so refunds on already-paid bookings
  // still work. "Connected" means disconnectedAt is null.
  disconnectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments BookingPayment[]
}

// A player's payment for court time. Deliberately NOT the Payment model above:
// that one is bound to a subscription, a plan and a billing period, none of
// which mean anything here, and it settles through the PLATFORM's webhook
// secret rather than the partner's.
model BookingPayment {
  id String @id @default(cuid())

  // Denormalized like Booking.hubId — the partner's list and the ownership
  // check shouldn't need a join.
  partnerId String
  gatewayId String
  userId    String // the player who paid
  // A scalar with no relation ON PURPOSE: deleting a hub must not destroy a
  // financial record.
  hubId     String

  amount   Decimal           @db.Decimal(10, 2)
  currency String            @default("PHP")
  method   PaymentMethodType
  status   PaymentStatus     @default(PENDING)

  // The hold this payment is racing — a snapshot of the bookings'
  // holdExpiresAt, so the checkout page can render a countdown from one read.
  expiresAt DateTime

  // THE double-charge guard. Claimed with
  //   updateMany({ where: { id, status: PENDING, chargeStartedAt: null } })
  // asserting count === 1 BEFORE the gateway is called — the same idiom as
  // the version guard in billing.ts. Cleared on a decline so the player can
  // retry with another card while the hold is still alive.
  chargeStartedAt DateTime?
  attempt         Int       @default(0)

  provider          String
  providerPaymentId String?
  providerClientKey String?
  redirectUrl       String? @db.Text
  providerRef       String?
  failureCode       String?
  failureMessage    String? @db.Text
  raw               Json?

  paidAt         DateTime?
  refundedAt     DateTime?
  refundedAmount Decimal?  @db.Decimal(10, 2)
  refundRef      String?
  refundReason   String?   @db.Text
  refundedById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner  User           @relation("PartnerBookingPayments", fields: [partnerId], references: [id], onDelete: Cascade)
  user     User           @relation("PlayerBookingPayments", fields: [userId], references: [id], onDelete: Cascade)
  gateway  PartnerGateway @relation(fields: [gatewayId], references: [id])
  bookings Booking[]

  @@index([partnerId, createdAt])
  @@index([userId, createdAt])
  @@index([hubId, createdAt])
  @@index([providerPaymentId])
  @@index([status, expiresAt])
}

// Webhook replay guard — real gateways retry deliveries.
//
// Venue payments reuse this table by namespacing `provider` as
// `venue:<gatewayId>`, so one partner's gateway can never burn another's
// eventId through the shared unique index.
model ProviderEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  type        String
  payload     Json
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
}

// A partner-operated venue/club profile.
model Hub {
  id             String   @id @default(cuid())
  ownerId        String
  name           String
  about          String?  @db.Text
  logo           String?  @db.Text // data URL
  coverPhotos    String[] // data URLs
  games          String[] // court games offered (see GAMES in constants)
  address        String?  @db.Text
  latitude       Float?
  longitude      Float?
  phone          String?
  email          String?
  operatingHours Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  courts   Court[]
  bookings Booking[]

  @@index([ownerId])
}

// A bookable court within a hub. Its schedule follows the hub's operating hours.
model Court {
  id         String   @id @default(cuid())
  hubId      String
  name       String
  courtType  String   @default("covered") // "covered" | "open"
  hourlyRate Decimal? @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  hub      Hub       @relation(fields: [hubId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([hubId])
}

// PENDING   — holding its hours until holdExpiresAt while payment settles.
// CONFIRMED — paid, OR a venue with no gateway connected (the original
//             behaviour: confirm now, settle at the venue).
// CANCELLED — the venue cancelled it.
// EXPIRED   — the hold lapsed unpaid. Terminal, slots deleted.
//
// EXPIRED is separate from CANCELLED on purpose: a partner's cancellation list
// must not fill with bookings that were never real, and the player needs to
// read "payment wasn't completed", not "cancelled by the venue".
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum CancelledBy {
  PLAYER
  PARTNER
  ADMIN
}

// Deliberately not CancelledBy: only the venue moves a booking, so that enum's
// PLAYER value would be unreachable here.
enum RescheduledBy {
  PARTNER
  ADMIN
}

// A court reservation of 1..MAX_BOOKING_HOURS contiguous hours.
//
// `date` is a "YYYY-MM-DD" Asia/Manila civil date; `startHour`/`endHour` are
// Manila local hours where `endHour` may be 24 (midnight the next day).
// `startsAt`/`endsAt` are the derived UTC instants, used ONLY for
// upcoming/past ordering — never for slot identity.
//
// There is no COMPLETED status: "past" is derived from `endsAt < now`.
model Booking {
  id           String        @id @default(cuid())
  courtId      String
  // Denormalized so the partner list and revalidation don't need a join.
  hubId        String
  userId       String
  date         String
  startHour    Int
  endHour      Int
  hours        Int
  startsAt     DateTime
  endsAt       DateTime
  // Snapshots: a partner can edit Court.hourlyRate after the booking is made.
  hourlyRate   Decimal?      @db.Decimal(10, 2)
  totalPrice   Decimal?      @db.Decimal(10, 2)
  status       BookingStatus @default(CONFIRMED)
  notes        String?       @db.Text
  cancelledAt  DateTime?
  cancelledBy  CancelledBy?
  cancelReason String?       @db.Text

  // --- Reschedule (venue-initiated move) ---------------------------------
  // Only the venue moves a booking. We keep just the IMMEDIATELY PRECEDING
  // state — all the player-facing "Moved by the venue" banner needs — plus a
  // count so repeated moves aren't invisible.
  //
  // prevCourtName is a SNAPSHOT, not a relation: courts get renamed and
  // deleted, and the player should still see the court they were originally
  // told. Nothing ever joins on it.
  rescheduledAt    DateTime?
  rescheduledBy    RescheduledBy?
  rescheduleReason String?        @db.Text
  rescheduleCount  Int            @default(0)
  prevCourtName    String?
  prevDate         String?
  prevStartHour    Int?
  prevEndHour      Int?
  prevTotalPrice   Decimal?       @db.Decimal(10, 2)

  // --- Pay-to-confirm hold -----------------------------------------------
  // Set ONLY while status is PENDING: the instant this booking stops holding
  // its hours if payment doesn't land. Mirrored onto BookingSlot — see the
  // comment there for why.
  holdExpiresAt    DateTime?
  // One payment can cover several bookings: a single submit of non-contiguous
  // hours creates one Booking per run but charges once.
  bookingPaymentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  court          Court           @relation(fields: [courtId], references: [id], onDelete: Cascade)
  hub            Hub             @relation(fields: [hubId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingPayment BookingPayment? @relation(fields: [bookingPaymentId], references: [id])
  slots          BookingSlot[]

  @@index([userId, startsAt])
  @@index([hubId, startsAt])
  @@index([courtId, date])
  @@index([status, holdExpiresAt])
}

// Live occupancy of a single court-hour.
//
// The @@unique([courtId, date, hour]) below is the ONLY thing preventing a
// double-booking: two concurrent transactions inserting the same key block,
// then one fails with P2002, rolling back its whole Booking.
//
// IMPORTANT: these rows are DELETED when a booking is cancelled, so the hour
// becomes bookable again. Do not soft-delete them — Prisma cannot express a
// partial unique index (`WHERE status = 'CONFIRMED'`), so a lingering row
// would block that hour forever. The parent Booking survives as CANCELLED.
model BookingSlot {
  id        String @id @default(cuid())
  bookingId String
  courtId   String
  date      String
  hour      Int

  // A MIRROR of Booking.holdExpiresAt. Denormalized deliberately:
  //
  //   1. This is the hottest read in the app — every open slot grid polls it
  //      every 3 seconds — and the expiry predicate must be evaluable without
  //      joining Booking.
  //   2. It makes the reap in createBookingAction a plain
  //      DELETE ... WHERE courtId=? AND date=? AND hour IN (...) AND holdExpiresAt < now().
  //      As a relation subquery that becomes a lock-order hazard in the one
  //      transaction that must never deadlock.
  //
  // The invariant (slot.holdExpiresAt === booking.holdExpiresAt) is written in
  // exactly three transactional places: the claim in createBookingAction, the
  // confirm in settleBookingPayment, and the delete in expireBookingHolds.
  // Drift is self-healing anyway — a stale value only ever makes a row stop
  // blocking EARLIER, and the sweep deletes it.
  holdExpiresAt DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([courtId, date, hour])
  @@index([bookingId])
  @@index([courtId, date])
  @@index([courtId, date, holdExpiresAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
