// Prisma schema for Sports 360
// Models follow the Auth.js (NextAuth) Prisma adapter conventions, extended
// with the player-profile fields captured during registration.
// Docs: https://authjs.dev/getting-started/adapters/prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PLAYER
  PARTNER
}

model User {
  id             String    @id @default(cuid())
  name           String?
  playerName     String?
  email          String    @unique
  emailVerified  DateTime?
  phone          String?
  image          String?
  passwordHash   String?
  role           Role      @default(PLAYER)
  skillLevel     String    @default("intermediate")
  privateProfile Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  hubs     Hub[]
}

// A partner-operated venue/club profile.
model Hub {
  id             String   @id @default(cuid())
  ownerId        String
  name           String
  about          String?  @db.Text
  logo           String?  @db.Text // data URL
  coverPhotos    String[] // data URLs
  games          String[] // court games offered (see GAMES in constants)
  address        String?  @db.Text
  phone          String?
  email          String?
  operatingHours Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner  User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  courts Court[]

  @@index([ownerId])
}

// A bookable court within a hub. Its schedule follows the hub's operating hours.
model Court {
  id         String   @id @default(cuid())
  hubId      String
  name       String
  courtType  String   @default("covered") // "covered" | "open"
  hourlyRate Decimal? @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  hub Hub @relation(fields: [hubId], references: [id], onDelete: Cascade)

  @@index([hubId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
