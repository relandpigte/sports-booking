// Prisma schema for Bunal.club
// Models follow the Auth.js (NextAuth) Prisma adapter conventions, extended
// with the player-profile fields captured during registration.
// Docs: https://authjs.dev/getting-started/adapters/prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PLAYER
  PARTNER
}

enum ChatConversationKind {
  EVENT
  HUB_PLAYER
  TRAINER_SESSION
}

enum ChatMessageKind {
  USER
  SYSTEM
}

enum ChatReportCategory {
  SPAM
  HARASSMENT
  INAPPROPRIATE
  OTHER
}

enum ChatReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum PartnerStatus {
  DRAFT
  PENDING
  ACTIVE
  DEACTIVATED
}

enum PartnerPaymentMode {
  AUTOMATIC
  MANUAL
}

enum TrainerStatus {
  DRAFT
  PENDING
  ACTIVE
  DEACTIVATED
}

enum TrainerAvailabilityExceptionType {
  AVAILABLE
  UNAVAILABLE
}

enum TrainerSessionStatus {
  REQUESTED
  AWAITING_PAYMENT
  PAYMENT_REVIEW
  CONFIRMED
  DECLINED
  EXPIRED
  CANCELLED
  COMPLETED
  REFUNDED
}

enum StaffAccessLevel {
  NONE
  VIEW
  MANAGE
}

enum OpenPlaySessionStatus {
  SETUP
  ACTIVE
  ENDED
}

enum OpenPlayQueueKind {
  EVENT
  QUICK
}

enum OpenPlayAdmissionMode {
  APPROVAL_REQUIRED
  INSTANT
}

enum OpenPlayMatchingMode {
  BALANCED
  SKILL_SEPARATED
  WINNERS_LOSERS
  FIXED_PARTNERS
}

enum OpenPlayParticipantSource {
  REGISTERED_PLAYER
  REGISTRATION_GUEST
  ORGANIZER_GUEST
  WALK_IN
  PUBLIC_GUEST
}

enum OpenPlayParticipantStatus {
  PENDING_APPROVAL
  NOT_CHECKED_IN
  QUEUED
  STAGED
  PLAYING
  PAUSED
  CHECKED_OUT
  REMOVED
}

enum OpenPlayLastResult {
  UNCLASSIFIED
  WIN
  LOSS
}

enum OpenPlayGameStatus {
  STAGED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum OpenPlaySelectionMethod {
  AUTOMATIC
  MANUAL
}

enum PaymentCollectionMode {
  AUTOMATIC
  MANUAL
}

enum ManualPaymentNetwork {
  GCASH
  MAYA
  BANK_TRANSFER
  OTHER
}

model User {
  id                      String             @id @default(cuid())
  name                    String?
  playerName              String?
  username                String?            @unique
  email                   String             @unique
  emailVerified           DateTime?
  phone                   String?
  // A venue's Facebook page, canonicalised to https://www.facebook.com/<page>
  // by src/lib/social.ts. For most Philippine venues this is their whole web
  // presence, so it is asked for at partner signup — optional, because
  // requiring it would turn away a venue that hasn't made one.
  facebookPage            String?
  image                   String?
  passwordHash            String?
  role                    Role               @default(PLAYER)
  skillLevel              String             @default("intermediate")
  privateProfile          Boolean            @default(false)
  // Existing and password-created accounts default to complete. The Auth.js
  // adapter explicitly writes null for a brand-new Google identity until its
  // app role has been selected.
  registrationCompletedAt DateTime?          @default(now())
  // Incremented after a password reset. JWTs carry the version they were
  // issued with, so the DAL can reject sessions created before the reset.
  sessionVersion          Int                @default(0)
  // Successful credential authentications only. The count is incremented
  // atomically so simultaneous sign-ins cannot lose an update.
  lastLoginAt             DateTime?
  loginCount              Int                @default(0)
  // Authenticator-app MFA. The secret is AES-256-GCM ciphertext; recovery
  // codes are stored as one-way hashes in MfaRecoveryCode.
  mfaEnabledAt            DateTime?
  mfaSecretEnc            String?            @db.Text
  // Only meaningful when role=PARTNER. Public signups start DRAFT, move to
  // PENDING after venue onboarding, then become ACTIVE after admin review.
  // DEACTIVATED is an explicit operational stop; it must not be conflated with
  // an application that is still awaiting its first review.
  partnerStatus           PartnerStatus?
  // One checkout policy per partner account, shared by every hub it owns.
  partnerPaymentMode      PartnerPaymentMode @default(AUTOMATIC)
  partnerActivatedAt      DateTime?
  // Claimed atomically by the maintenance sweep before an overdue service-fee
  // reminder is sent. This throttles reminders across concurrent cron runs.
  serviceFeeReminderAt    DateTime?
  // Scalar by design: deleting an admin must not erase who approved a partner.
  partnerActivatedById    String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  chatRestrictedAt        DateTime?
  chatRestrictionReason   String?            @db.VarChar(200)
  // Scalar audit fact: deleting an administrator must not erase who applied
  // a restriction to an account.
  chatRestrictedById      String?

  accounts             Account[]
  sessions             Session[]
  hubs                 Hub[]
  bookings             Booking[]
  passwordResetToken   PasswordResetToken?
  authSessions         AuthSession[]
  authGrants           AuthGrant[]
  securityChallenges   SecurityChallenge[]
  securityEvents       SecurityEvent[]
  mfaRecoveryCodes     MfaRecoveryCode[]
  chatHubConversations ChatConversation[]  @relation("ChatHubPlayer")
  chatMessages         ChatMessage[]       @relation("ChatMessageSender")
  chatReadStates       ChatReadState[]
  chatBlocksCreated    ChatBlock[]         @relation("ChatBlocker")
  chatBlocksReceived   ChatBlock[]         @relation("ChatBlocked")
  chatReports          ChatReport[]        @relation("ChatReporter")

  trainerProfile          TrainerProfile?
  trainerGateway          TrainerGateway?
  trainerManualMethods    TrainerManualPaymentMethod[]
  trainerSessionsBooked   TrainerSession[]              @relation("TrainerSessionPlayer")
  trainerPaymentsMade     TrainerPayment[]              @relation("TrainerPaymentPlayer")
  trainerPaymentsReceived TrainerPayment[]              @relation("TrainerPaymentTrainer")
  trainerFeeEntries       TrainerServiceFeeEntry[]      @relation("TrainerServiceFeeOwner")
  trainerFeeSettlements   TrainerServiceFeeSettlement[] @relation("TrainerServiceFeeSettlementOwner")

  partnerGateway            PartnerGateway?
  manualPaymentMethods      PartnerManualPaymentMethod[]
  bookingPayments           BookingPayment[]             @relation("PlayerBookingPayments")
  venuePayments             BookingPayment[]             @relation("PartnerBookingPayments")
  eventRegistrations        EventRegistration[]
  openPlayParticipants      OpenPlayParticipant[]
  organizerEventGuests      EventOrganizerGuest[]        @relation("OrganizerEventGuestCreator")
  serviceFeeEntries         ServiceFeeEntry[]            @relation("PartnerServiceFeeEntries")
  serviceFeeSettlements     ServiceFeeSettlement[]       @relation("PartnerServiceFeeSettlements")
  serviceFeeWaivers         ServiceFeeWaiver[]           @relation("PartnerServiceFeeWaivers")
  serviceFeeWaiversGranted  ServiceFeeWaiver[]           @relation("ServiceFeeWaiverGrantor")
  serviceFeeWaiversReversed ServiceFeeWaiver[]           @relation("ServiceFeeWaiverReverser")

  staffMembershipsOwned   PartnerStaffMembership[] @relation("PartnerStaffOwner")
  staffMembership         PartnerStaffMembership?  @relation("PartnerStaffUser")
  staffMembershipsInvited PartnerStaffMembership[] @relation("PartnerStaffMembershipInviter")
  staffInvitationsOwned   PartnerStaffInvitation[] @relation("PartnerStaffInvitationOwner")
  staffInvitationsSent    PartnerStaffInvitation[] @relation("PartnerStaffInvitationInviter")
  staffActivityOwned      PartnerStaffActivity[]   @relation("PartnerStaffActivityOwner")
  staffActivityPerformed  PartnerStaffActivity[]   @relation("PartnerStaffActivityActor")
}

// A trainer is a capability attached to a PLAYER account. The account keeps
// every player ability while this profile supplies the independently reviewed
// public identity, availability, rate, and payout settings.
model TrainerProfile {
  id                   String             @id @default(cuid())
  userId               String             @unique
  status               TrainerStatus      @default(DRAFT)
  bio                  String?            @db.Text
  sports               String[]
  specialties          String[]
  experience           String?            @db.Text
  certifications       String?            @db.Text
  area                 String?
  locationDetails      String?            @db.Text
  hourlyRate           Decimal?           @db.Decimal(10, 2)
  facebookPage         String?
  paymentMode          PartnerPaymentMode @default(AUTOMATIC)
  submittedAt          DateTime?
  activatedAt          DateTime?
  activatedById        String?
  deactivatedAt        DateTime?
  deactivationReason   String?            @db.Text
  facebookReviewedAt   DateTime?
  facebookReviewedById String?
  serviceFeeReminderAt DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user        User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyRules TrainerAvailabilityRule[]
  exceptions  TrainerAvailabilityException[]
  sessions    TrainerSession[]
  slots       TrainerSessionSlot[]

  @@index([status, updatedAt])
  @@index([area])
}

model TrainerAvailabilityRule {
  id               String   @id @default(cuid())
  trainerProfileId String
  dayOfWeek        Int
  startHour        Int
  endHour          Int
  createdAt        DateTime @default(now())

  trainer TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)

  @@unique([trainerProfileId, dayOfWeek, startHour, endHour])
  @@index([trainerProfileId, dayOfWeek])
}

model TrainerAvailabilityException {
  id               String                           @id @default(cuid())
  trainerProfileId String
  date             String
  startHour        Int
  endHour          Int
  type             TrainerAvailabilityExceptionType
  note             String?                          @db.VarChar(200)
  createdAt        DateTime                         @default(now())

  trainer TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)

  @@unique([trainerProfileId, date, startHour, endHour, type])
  @@index([trainerProfileId, date])
}

model TrainerSession {
  id               String               @id @default(cuid())
  publicId         String               @unique
  trainerProfileId String
  playerId         String
  date             String
  startHour        Int
  endHour          Int
  hours            Int
  startsAt         DateTime
  endsAt           DateTime
  status           TrainerSessionStatus @default(REQUESTED)
  notes            String?              @db.Text
  hourlyRate       Decimal              @db.Decimal(10, 2)
  trainerAmount    Decimal              @db.Decimal(10, 2)
  platformFee      Decimal              @db.Decimal(10, 2)
  processingFee    Decimal              @default(0) @db.Decimal(10, 2)
  totalAmount      Decimal              @db.Decimal(10, 2)
  requestExpiresAt DateTime
  paymentExpiresAt DateTime?
  acceptedAt       DateTime?
  declinedAt       DateTime?
  declineReason    String?              @db.Text
  confirmedAt      DateTime?
  cancelledAt      DateTime?
  cancelledBy      CancelledBy?
  cancelReason     String?              @db.Text
  refundedAt       DateTime?
  completedAt      DateTime?
  reminderSentAt   DateTime?
  prevDate         String?
  prevStartHour    Int?
  prevEndHour      Int?
  rescheduledAt    DateTime?
  rescheduledById  String?
  rescheduleReason String?              @db.Text
  rescheduleCount  Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  trainer      TrainerProfile       @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)
  player       User                 @relation("TrainerSessionPlayer", fields: [playerId], references: [id], onDelete: Cascade)
  slots        TrainerSessionSlot[]
  payment      TrainerPayment?
  conversation ChatConversation?

  @@index([trainerProfileId, status, startsAt])
  @@index([playerId, status, startsAt])
  @@index([status, requestExpiresAt])
  @@index([status, paymentExpiresAt])
  @@index([status, startsAt])
}

model TrainerSessionSlot {
  id               String @id @default(cuid())
  trainerProfileId String
  trainerSessionId String
  date             String
  hour             Int

  trainer TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)
  session TrainerSession @relation(fields: [trainerSessionId], references: [id], onDelete: Cascade)

  @@unique([trainerProfileId, date, hour])
  @@index([trainerSessionId])
}

model TrainerGateway {
  id               String    @id @default(cuid())
  userId           String    @unique
  provider         String    @default("paymongo")
  publicKey        String
  secretKeyEnc     String    @db.Text
  webhookSecretEnc String    @db.Text
  secretKeyHint    String
  webhookToken     String    @unique
  webhookVersion   Int       @default(1)
  accountLabel     String?
  connectedAt      DateTime  @default(now())
  disconnectedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments TrainerPayment[]
}

model TrainerManualPaymentMethod {
  id                String               @id @default(cuid())
  trainerId         String
  network           ManualPaymentNetwork
  label             String
  accountName       String?
  accountIdentifier String?
  instructions      String?              @db.Text
  qrImage           String?              @db.Text
  active            Boolean              @default(true)
  sortOrder         Int                  @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  trainer  User             @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  payments TrainerPayment[]

  @@index([trainerId, active, sortOrder])
}

model TrainerPayment {
  id                    String                @id @default(cuid())
  trainerSessionId      String                @unique
  trainerId             String
  playerId              String
  gatewayId             String?
  manualPaymentMethodId String?
  amount                Decimal               @db.Decimal(10, 2)
  trainerAmount         Decimal               @db.Decimal(10, 2)
  platformFee           Decimal               @db.Decimal(10, 2)
  processingFee         Decimal               @default(0) @db.Decimal(10, 2)
  currency              String                @default("PHP")
  method                PaymentMethodType
  collectionMode        PaymentCollectionMode @default(AUTOMATIC)
  status                PaymentStatus         @default(PENDING)
  expiresAt             DateTime
  chargeStartedAt       DateTime?
  attempt               Int                   @default(0)
  provider              String
  providerPaymentId     String?
  providerClientKey     String?
  redirectUrl           String?               @db.Text
  qrImageUrl            String?               @db.Text
  providerRef           String?
  failureCode           String?
  failureMessage        String?               @db.Text
  raw                   Json?
  manualMethodLabel     String?
  manualAccountName     String?
  manualAccountDetails  String?               @db.Text
  manualInstructions    String?               @db.Text
  manualQrImage         String?               @db.Text
  manualReceiptImage    String?               @db.Text
  manualPaymentRef      String?
  manualSubmittedAt     DateTime?
  manualReviewedAt      DateTime?
  manualReviewedById    String?
  manualReviewNote      String?               @db.Text
  paidAt                DateTime?
  refundedAt            DateTime?
  refundedAmount        Decimal?              @db.Decimal(10, 2)
  refundRef             String?
  refundReason          String?               @db.Text
  refundedById          String?
  refundRequestedAt     DateTime?
  refundRequestedById   String?
  refundStartedAt       DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  session             TrainerSession              @relation(fields: [trainerSessionId], references: [id], onDelete: Cascade)
  trainer             User                        @relation("TrainerPaymentTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  player              User                        @relation("TrainerPaymentPlayer", fields: [playerId], references: [id], onDelete: Cascade)
  gateway             TrainerGateway?             @relation(fields: [gatewayId], references: [id])
  manualPaymentMethod TrainerManualPaymentMethod? @relation(fields: [manualPaymentMethodId], references: [id], onDelete: SetNull)
  serviceFeeEntries   TrainerServiceFeeEntry[]

  @@index([trainerId, createdAt])
  @@index([playerId, createdAt])
  @@index([providerPaymentId])
  @@index([status, expiresAt])
}

model TrainerServiceFeeEntry {
  id               String              @id @default(cuid())
  trainerId        String
  trainerPaymentId String
  type             ServiceFeeEntryType
  amount           Decimal             @db.Decimal(10, 2)
  createdAt        DateTime            @default(now())

  trainer User           @relation("TrainerServiceFeeOwner", fields: [trainerId], references: [id], onDelete: Cascade)
  payment TrainerPayment @relation(fields: [trainerPaymentId], references: [id], onDelete: Cascade)

  @@unique([trainerPaymentId, type])
  @@index([trainerId, createdAt])
}

model TrainerServiceFeeSettlement {
  id               String                     @id @default(cuid())
  trainerId        String
  periodStart      DateTime
  periodEnd        DateTime
  amount           Decimal                    @db.Decimal(10, 2)
  currency         String                     @default("PHP")
  status           ServiceFeeSettlementStatus @default(SUBMITTED)
  paymentReference String?
  receiptImage     String?                    @db.Text

  // Present for platform PayMongo QR Ph settlements. Manual proof
  // submissions leave these null and continue through admin review.
  provider          String?
  providerPaymentId String? @unique
  providerRef       String?
  redirectUrl       String? @db.Text
  raw               Json?

  submittedAt  DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  reviewNote   String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  trainer User @relation("TrainerServiceFeeSettlementOwner", fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId, submittedAt])
  @@index([status, submittedAt])
}

// A player identity may work for one partner team. Permissions are explicit
// columns so every query and mutation can be checked without interpreting
// untyped JSON. Removing staff deletes this active row; the activity log keeps
// the durable audit history.
model PartnerStaffMembership {
  id          String           @id @default(cuid())
  partnerId   String
  userId      String           @unique
  invitedById String
  hubs        StaffAccessLevel @default(NONE)
  bookings    StaffAccessLevel @default(NONE)
  events      StaffAccessLevel @default(NONE)
  reports     StaffAccessLevel @default(NONE)
  messages    StaffAccessLevel @default(NONE)
  payments    StaffAccessLevel @default(NONE)
  openPlay    StaffAccessLevel @default(NONE)
  acceptedAt  DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  partner   User @relation("PartnerStaffOwner", fields: [partnerId], references: [id], onDelete: Cascade)
  user      User @relation("PartnerStaffUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User @relation("PartnerStaffMembershipInviter", fields: [invitedById], references: [id], onDelete: Restrict)

  @@unique([partnerId, userId])
  @@index([partnerId, createdAt])
}

// Only live invitations are retained. Resending rotates tokenHash/expiresAt;
// accepting or cancelling deletes the row after writing an activity record.
model PartnerStaffInvitation {
  id          String           @id @default(cuid())
  partnerId   String
  invitedById String
  email       String           @unique
  tokenHash   String           @unique
  hubs        StaffAccessLevel @default(NONE)
  bookings    StaffAccessLevel @default(NONE)
  events      StaffAccessLevel @default(NONE)
  reports     StaffAccessLevel @default(NONE)
  messages    StaffAccessLevel @default(NONE)
  payments    StaffAccessLevel @default(NONE)
  openPlay    StaffAccessLevel @default(NONE)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  partner   User @relation("PartnerStaffInvitationOwner", fields: [partnerId], references: [id], onDelete: Cascade)
  invitedBy User @relation("PartnerStaffInvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([partnerId, createdAt])
  @@index([expiresAt])
}

model PartnerStaffActivity {
  id         String   @id @default(cuid())
  partnerId  String
  actorId    String?
  action     String   @db.VarChar(80)
  targetType String?  @db.VarChar(80)
  targetId   String?  @db.VarChar(120)
  metadata   Json?
  createdAt  DateTime @default(now())

  partner User  @relation("PartnerStaffActivityOwner", fields: [partnerId], references: [id], onDelete: Cascade)
  actor   User? @relation("PartnerStaffActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([partnerId, createdAt])
  @@index([actorId, createdAt])
}

// A short-lived, single-use credential exchanged for an Auth.js JWT. Passwords
// and MFA codes never enter the JWT provider; authorize() accepts only a random
// grant whose SHA-256 hash is stored here.
model AuthGrant {
  id              String    @id @default(cuid())
  tokenHash       String    @unique
  userId          String
  mfaVerified     Boolean
  deviceHash      String
  deviceLabel     String
  browser         String?
  operatingSystem String?
  location        String?
  ipHash          String
  ipPrefix        String?
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

// Server-side registry for otherwise stateless Auth.js JWT sessions. The JWT
// carries the random session token; only its hash is stored in Postgres.
model AuthSession {
  id              String    @id @default(cuid())
  tokenHash       String    @unique
  userId          String
  mfaVerified     Boolean
  deviceHash      String
  deviceLabel     String
  browser         String?
  operatingSystem String?
  location        String?
  ipHash          String
  ipPrefix        String?
  createdAt       DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

// Login MFA and MFA-enrolment challenges. The browser receives only the random
// token; the database stores its hash. A setup secret is encrypted at rest.
model SecurityChallenge {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  purpose    String
  secretEnc  String?   @db.Text
  redirectTo String?
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@index([expiresAt])
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

// Append-only account security history. Metadata is intentionally limited to
// non-secret device and outcome details by the callers.
model SecurityEvent {
  id          String   @id @default(cuid())
  userId      String
  type        String
  deviceLabel String?
  location    String?
  ipHash      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

// Progressive login throttling keys are HMAC/SHA-256 digests of an IP and the
// normalized email/IP pair. Raw attempted addresses and raw IPs are not stored.
model LoginThrottle {
  keyHash         String    @id
  attempts        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([blockedUntil])
}

// One active reset request per normalized email. The raw email and raw token
// are never stored: emailHash supports request throttling without retaining
// mistyped addresses, and tokenHash makes a database leak insufficient to
// reset an account.
model PasswordResetToken {
  id          String   @id @default(cuid())
  emailHash   String   @unique
  tokenHash   String   @unique
  userId      String?  @unique
  expiresAt   DateTime
  requestedAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

enum PaymentMethodType {
  QRPH
  CARD
  GCASH
  MAYA
  BANK_TRANSFER
  OTHER
  MANUAL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum ServiceFeeEntryType {
  CHARGE
  REFUND
}

enum ServiceFeeSettlementStatus {
  AWAITING_PAYMENT
  SUBMITTED
  PAID
  REJECTED
}

// --- Players paying venues ---------------------------------------------------
// Players pay partners through the partner's own gateway account. Bunal.club has
// no subscription plans; each booking fee accrues for later remittance.

// One row per PARTNER ACCOUNT, shared by every hub they own.
model PartnerGateway {
  id       String @id @default(cuid())
  userId   String @unique
  provider String @default("fake")

  // Publishable key — not a secret, safe to render.
  publicKey String

  // AES-256-GCM ciphertext (src/lib/crypto.ts). NEVER selected into a view
  // type, NEVER logged, NEVER echoed back into form state.
  secretKeyEnc     String @db.Text
  webhookSecretEnc String @db.Text
  // Last few characters of the secret, so the UI can show "sk_test_…9f2a"
  // without ever decrypting anything.
  secretKeyHint    String

  // The unguessable path segment of THIS partner's webhook URL. Random bytes,
  // deliberately not the user id — this string gets pasted into a third
  // party's dashboard.
  webhookToken String @unique

  // Incremented after the account webhook is subscribed to the direct
  // Payment Intent events required by the current venue gateway adapter.
  webhookVersion Int @default(1)

  accountLabel   String?
  connectedAt    DateTime  @default(now())
  // Disconnecting keeps the ciphertext, so refunds on already-paid bookings
  // still work. "Connected" means disconnectedAt is null.
  disconnectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments BookingPayment[]
}

// A partner-managed destination shown only when their account uses manual
// collection. QR images and instructions are snapshotted onto each submitted
// payment so later edits cannot change the evidence the player reviewed.
model PartnerManualPaymentMethod {
  id                String               @id @default(cuid())
  partnerId         String
  network           ManualPaymentNetwork
  label             String
  accountName       String?
  accountIdentifier String?
  instructions      String?              @db.Text
  qrImage           String?              @db.Text
  active            Boolean              @default(true)
  sortOrder         Int                  @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  partner  User             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  payments BookingPayment[]

  @@index([partnerId, active, sortOrder])
}

// Bunal.club's own PayMongo account, configured by an admin. This is a
// singleton in practice (`provider` is unique), separate from partner-owned
// gateways because it receives service-fee remittances rather than booking
// revenue.
model PlatformGateway {
  id       String @id @default(cuid())
  provider String @unique @default("paymongo")

  // AES-256-GCM ciphertext. Neither value is ever selected into a client view.
  secretKeyEnc     String  @db.Text
  webhookSecretEnc String  @db.Text
  secretKeyHint    String
  webhookUrl       String? @db.Text

  accountLabel   String?
  connectedById  String?
  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// A player's payment for court time.
model BookingPayment {
  id String @id @default(cuid())

  // Denormalized like Booking.hubId — the partner's list and the ownership
  // check shouldn't need a join.
  partnerId          String
  gatewayId          String?
  userId             String? // the signed-in player who paid; null for guest checkout
  // A guest cart owns the same payment ledger without creating a User row.
  // Exactly one of userId / guestReservationId is required by the migration.
  guestReservationId String? @unique
  // A scalar with no relation ON PURPOSE: deleting a hub must not destroy a
  // financial record.
  hubId              String

  // The booking subtotal: court time plus the Bunal.club service fee.
  amount         Decimal               @db.Decimal(10, 2)
  // The venue's share — the court time they advertised.
  venueAmount    Decimal               @default(0) @db.Decimal(10, 2)
  // Bunal.club's per-booking service fee.
  //
  // All three are stored rather than derived on purpose: the fee schedule can
  // change, and an older payment must keep the fee quoted at checkout.
  platformFee    Decimal               @default(0) @db.Decimal(10, 2)
  // The QR Ph processing fee grossed up onto the direct Payment Intent so the
  // partner receives the complete booking subtotal.
  processingFee  Decimal               @default(0) @db.Decimal(10, 2)
  currency       String                @default("PHP")
  method         PaymentMethodType
  collectionMode PaymentCollectionMode @default(AUTOMATIC)
  status         PaymentStatus         @default(PENDING)

  // The hold this payment is racing — a snapshot of the bookings'
  // holdExpiresAt, so the checkout page can render a countdown from one read.
  expiresAt DateTime

  // THE double-charge guard. Claimed with
  //   updateMany({ where: { id, status: PENDING, chargeStartedAt: null } })
  // asserting count === 1 BEFORE the gateway is called. Cleared on a decline
  // so the player can retry with another card while the hold is still alive.
  chargeStartedAt DateTime?
  attempt         Int       @default(0)

  provider          String
  providerPaymentId String?
  providerClientKey String?
  redirectUrl       String? @db.Text
  qrImageUrl        String? @db.Text
  providerRef       String?
  failureCode       String?
  failureMessage    String? @db.Text
  raw               Json?

  manualPaymentMethodId String?
  manualMethodLabel     String?
  manualAccountName     String?
  manualAccountDetails  String?   @db.Text
  manualInstructions    String?   @db.Text
  manualQrImage         String?   @db.Text
  manualReceiptImage    String?   @db.Text
  manualPaymentRef      String?
  manualSubmittedAt     DateTime?
  manualReviewedAt      DateTime?
  manualReviewedById    String?
  manualReviewNote      String?   @db.Text

  paidAt         DateTime?
  refundedAt     DateTime?
  refundedAmount Decimal?  @db.Decimal(10, 2)
  refundRef      String?
  refundReason   String?   @db.Text
  refundedById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner             User                        @relation("PartnerBookingPayments", fields: [partnerId], references: [id], onDelete: Cascade)
  user                User?                       @relation("PlayerBookingPayments", fields: [userId], references: [id], onDelete: Cascade)
  guestReservation    GuestReservation?           @relation(fields: [guestReservationId], references: [id], onDelete: Cascade)
  gateway             PartnerGateway?             @relation(fields: [gatewayId], references: [id])
  manualPaymentMethod PartnerManualPaymentMethod? @relation(fields: [manualPaymentMethodId], references: [id], onDelete: SetNull)
  bookings            Booking[]
  eventRegistration   EventRegistration?
  eventGuestSlots     EventGuestSlot[]
  serviceFeeEntries   ServiceFeeEntry[]

  @@index([partnerId, createdAt])
  @@index([userId, createdAt])
  @@index([guestReservationId, createdAt])
  @@index([hubId, createdAt])
  @@index([providerPaymentId])
  @@index([manualPaymentMethodId])
  @@index([partnerId, manualSubmittedAt])
  @@index([status, expiresAt])
}

// One anonymous checkout reservation. Contact details are snapshots, not
// accounts, and remain separate even when the email matches an existing User.
// Email access tokens are stored separately as hashes so several idempotent
// lifecycle emails can keep valid private links without storing raw secrets.
model GuestReservation {
  id              String   @id @default(cuid())
  name            String
  phone           String
  email           String
  accessExpiresAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bookings     Booking[]
  payment      BookingPayment?
  accessTokens GuestReservationAccessToken[]

  @@index([email, createdAt])
  @@index([accessExpiresAt])
}

model GuestReservationAccessToken {
  id                 String   @id @default(cuid())
  guestReservationId String
  tokenHash          String   @unique
  expiresAt          DateTime
  createdAt          DateTime @default(now())

  guestReservation GuestReservation @relation(fields: [guestReservationId], references: [id], onDelete: Cascade)

  @@index([guestReservationId, expiresAt])
  @@index([expiresAt])
}

// Immutable service-fee ledger. Successful bookings and organizer-added event
// players add positive charges. Booking refunds retain their charge, while
// removing an organizer-added player records an explicit negative REFUND. A
// database check requires exactly one source, and source/type keys keep retries
// and concurrent action races idempotent.
model ServiceFeeEntry {
  id                    String              @id @default(cuid())
  partnerId             String
  bookingPaymentId      String?
  eventOrganizerGuestId String?
  type                  ServiceFeeEntryType
  amount                Decimal             @db.Decimal(10, 2)
  createdAt             DateTime            @default(now())

  partner             User                 @relation("PartnerServiceFeeEntries", fields: [partnerId], references: [id], onDelete: Cascade)
  bookingPayment      BookingPayment?      @relation(fields: [bookingPaymentId], references: [id], onDelete: Cascade)
  eventOrganizerGuest EventOrganizerGuest? @relation(fields: [eventOrganizerGuestId], references: [id], onDelete: Restrict)

  @@unique([bookingPaymentId, type])
  @@unique([eventOrganizerGuestId, type])
  @@index([partnerId, createdAt])
  @@index([eventOrganizerGuestId])
}

// A partner's remittance of accumulated service fees to Bunal.club. The amount
// is snapshotted before either a PayMongo checkout or manual proof submission.
model ServiceFeeSettlement {
  id               String                     @id @default(cuid())
  partnerId        String
  periodStart      DateTime
  periodEnd        DateTime
  amount           Decimal                    @db.Decimal(10, 2)
  currency         String                     @default("PHP")
  status           ServiceFeeSettlementStatus @default(SUBMITTED)
  paymentReference String?
  receiptImage     String?                    @db.Text

  // Present for PayMongo QR Ph settlements. Manual proof submissions leave
  // these null and continue through admin review.
  provider          String?
  providerPaymentId String? @unique
  providerRef       String?
  redirectUrl       String? @db.Text
  raw               Json?

  submittedAt  DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  reviewNote   String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  partner User @relation("PartnerServiceFeeSettlements", fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, submittedAt])
  @@index([status, submittedAt])
}

// An explicit administrative credit against a partner's service-fee balance.
// Waivers never masquerade as cash settlements and never modify the immutable
// per-payment charge ledger. Reversal metadata is retained instead of deleting
// the waiver so every financial decision remains attributable and reviewable.
model ServiceFeeWaiver {
  id            String   @id @default(cuid())
  partnerId     String
  amount        Decimal  @db.Decimal(10, 2)
  reason        String   @db.Text
  grantedById   String
  balanceBefore Decimal  @db.Decimal(10, 2)
  balanceAfter  Decimal  @db.Decimal(10, 2)
  grantedAt     DateTime @default(now())

  reversedAt            DateTime?
  reversedById          String?
  reversalReason        String?   @db.Text
  reversalBalanceBefore Decimal?  @db.Decimal(10, 2)
  reversalBalanceAfter  Decimal?  @db.Decimal(10, 2)
  updatedAt             DateTime  @updatedAt

  partner    User  @relation("PartnerServiceFeeWaivers", fields: [partnerId], references: [id], onDelete: Cascade)
  grantedBy  User  @relation("ServiceFeeWaiverGrantor", fields: [grantedById], references: [id], onDelete: Restrict)
  reversedBy User? @relation("ServiceFeeWaiverReverser", fields: [reversedById], references: [id], onDelete: Restrict)

  @@index([partnerId, grantedAt])
  @@index([reversedAt, grantedAt])
}

// Webhook replay guard — real gateways retry deliveries.
//
// Venue payments reuse this table by namespacing `provider` as
// `venue:<gatewayId>`, so one partner's gateway can never burn another's
// eventId through the shared unique index.
model ProviderEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  type        String
  payload     Json
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
}

// A short-lived admin assistance session. The browser holds only the random
// token; its SHA-256 hash is stored here so a database read cannot recreate an
// active impersonation cookie. Admin and partner ids remain as immutable audit
// facts even if either account is later removed.
model PartnerImpersonationSession {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  adminId      String
  partnerId    String
  startedAt    DateTime  @default(now())
  expiresAt    DateTime
  endedAt      DateTime?
  endedReason  String?
  lastActionAt DateTime  @default(now())

  @@index([adminId, endedAt, expiresAt])
  @@index([partnerId, startedAt])
}

// Operational mutations performed while assisting a partner. These rows are
// append-only and intentionally keep plain ids rather than cascading user
// relations so deleting an account cannot erase the administrative record.
model PartnerImpersonationAudit {
  id         String   @id @default(cuid())
  sessionId  String?
  adminId    String
  partnerId  String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([partnerId, createdAt])
  @@index([adminId, createdAt])
  @@index([sessionId, createdAt])
}

// A partner-operated venue/club profile.
model Hub {
  id             String   @id @default(cuid())
  // Stable public URL segment. Optional so existing production rows continue
  // to resolve by id until a partner chooses or saves a slug.
  slug           String?  @unique
  ownerId        String
  name           String
  about          String?  @db.Text
  logo           String?  @db.Text // data URL
  coverPhotos    String[] // data URLs
  games          String[] // court games offered (see GAMES in constants)
  address        String?  @db.Text
  latitude       Float?
  longitude      Float?
  phone          String?
  email          String?
  operatingHours Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner             User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  courts            Court[]
  bookings          Booking[]
  events            Event[]
  openPlayQueues    OpenPlayQueue[]
  courtBlocks       CourtBlock[]
  chatConversations ChatConversation[]

  @@index([ownerId])
}

// A bookable court within a hub. Hub operating hours define its outer weekly
// window; sparse CourtSlotRule rows close individual hours or override price.
model Court {
  id         String   @id @default(cuid())
  hubId      String
  name       String
  // Nullable only for legacy courts at multi-sport hubs. New and edited
  // courts must select one of their hub's sports.
  sport      String?
  courtType  String   @default("covered") // "covered" | "open"
  hourlyRate Decimal? @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  hub               Hub                     @relation(fields: [hubId], references: [id], onDelete: Cascade)
  bookings          Booking[]
  scheduleRules     CourtSlotRule[]
  eventCourts       EventCourt[]
  openPlayCourts    OpenPlaySessionCourt[]
  openPlayGames     OpenPlayGame[]
  scheduleRevisions CourtScheduleRevision[]

  @@index([hubId])
  @@index([hubId, sport])
}

// Immutable, effective-dated snapshots of the availability denominator used
// by utilization reporting. The launch snapshot begins on migration day; a
// report before that date deliberately falls back to today's schedule and is
// labelled Estimated utilization.
model CourtScheduleRevision {
  id             String   @id @default(cuid())
  courtId        String
  effectiveFrom  String
  effectiveTo    String?
  operatingHours Json?
  slotRules      Json
  createdAt      DateTime @default(now())

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@unique([courtId, effectiveFrom])
  @@index([courtId, effectiveFrom, effectiveTo])
}

enum CourtBlockType {
  WALK_IN
  MAINTENANCE
  PRIVATE_USE
  OTHER
}

// A date-specific court closure created by a partner. Active blocks own the
// same BookingSlot rows as bookings and published events, so the database's
// unique court/date/hour key remains the single concurrency-safe conflict
// guard. Releasing a block deletes its slots but keeps this row for history.
model CourtBlock {
  id            String         @id @default(cuid())
  hubId         String
  type          CourtBlockType
  date          String
  startHour     Int
  endHour       Int
  publicReason  String?        @db.VarChar(120)
  customerName  String?        @db.VarChar(120)
  customerPhone String?        @db.VarChar(40)
  amountPaid    Decimal?       @db.Decimal(10, 2)
  internalNote  String?        @db.VarChar(500)
  createdById   String
  releasedAt    DateTime?
  releasedById  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  hub   Hub           @relation(fields: [hubId], references: [id], onDelete: Cascade)
  slots BookingSlot[]

  @@index([hubId, date, releasedAt])
  @@index([date, endHour])
}

// A recurring rule for one court-hour. `weekday` is ISO-style Monday=0 through
// Sunday=6. Rows are intentionally sparse: no row means "open at the court's
// default rate" whenever the hub itself is open. Closed rules can carry a
// short player-facing explanation such as maintenance or a private event.
model CourtSlotRule {
  id            String   @id @default(cuid())
  courtId       String
  weekday       Int
  hour          Int
  closed        Boolean  @default(false)
  closureReason String?  @db.VarChar(120)
  hourlyRate    Decimal? @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@unique([courtId, weekday, hour])
  @@index([courtId, weekday])
}

// PENDING   — holding its hours until holdExpiresAt while payment settles.
// CONFIRMED — paid, OR a venue with no gateway connected (the original
//             behaviour: confirm now, settle at the venue).
// CANCELLED — the venue cancelled it.
// EXPIRED   — the hold lapsed unpaid. Terminal, slots deleted.
//
// EXPIRED is separate from CANCELLED on purpose: a partner's cancellation list
// must not fill with bookings that were never real, and the player needs to
// read "payment wasn't completed", not "cancelled by the venue".
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum CancelledBy {
  PLAYER
  PARTNER
  ADMIN
}

// Deliberately not CancelledBy: only the venue moves a booking, so that enum's
// PLAYER value would be unreachable here.
enum RescheduledBy {
  PARTNER
  ADMIN
}

// A court reservation of 1..MAX_BOOKING_HOURS contiguous hours.
//
// `date` is a "YYYY-MM-DD" Asia/Manila civil date; `startHour`/`endHour` are
// Manila local hours where `endHour` may be 24 (midnight the next day).
// `startsAt`/`endsAt` are the derived UTC instants, used ONLY for
// upcoming/past ordering — never for slot identity.
//
// There is no COMPLETED status: "past" is derived from `endsAt < now`.
model Booking {
  id                 String        @id @default(cuid())
  courtId            String
  // Denormalized so the partner list and revalidation don't need a join.
  hubId              String
  userId             String?
  guestReservationId String?
  date               String
  startHour          Int
  endHour            Int
  hours              Int
  startsAt           DateTime
  endsAt             DateTime
  // Snapshots: a partner can edit Court.hourlyRate after the booking is made.
  hourlyRate         Decimal?      @db.Decimal(10, 2)
  totalPrice         Decimal?      @db.Decimal(10, 2)
  status             BookingStatus @default(CONFIRMED)
  // The moment this reservation first became eligible for Messages. Existing
  // confirmed rows are backfilled during the chat migration.
  confirmedAt        DateTime?
  notes              String?       @db.Text
  cancelledAt        DateTime?
  cancelledBy        CancelledBy?
  cancelReason       String?       @db.Text

  // --- Reschedule (venue-initiated move) ---------------------------------
  // Only the venue moves a booking. We keep just the IMMEDIATELY PRECEDING
  // state — all the player-facing "Moved by the venue" banner needs — plus a
  // count so repeated moves aren't invisible.
  //
  // prevCourtName is a SNAPSHOT, not a relation: courts get renamed and
  // deleted, and the player should still see the court they were originally
  // told. Nothing ever joins on it.
  rescheduledAt    DateTime?
  rescheduledBy    RescheduledBy?
  rescheduleReason String?        @db.Text
  rescheduleCount  Int            @default(0)
  prevCourtName    String?
  prevDate         String?
  prevStartHour    Int?
  prevEndHour      Int?
  prevTotalPrice   Decimal?       @db.Decimal(10, 2)

  // --- Pay-to-confirm hold -----------------------------------------------
  // Set ONLY while status is PENDING: the instant this booking stops holding
  // its hours if payment doesn't land. Mirrored onto BookingSlot — see the
  // comment there for why.
  holdExpiresAt    DateTime?
  // One payment can cover several bookings: a single submit of non-contiguous
  // hours creates one Booking per run but charges once.
  bookingPaymentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  court            Court             @relation(fields: [courtId], references: [id], onDelete: Cascade)
  hub              Hub               @relation(fields: [hubId], references: [id], onDelete: Cascade)
  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestReservation GuestReservation? @relation(fields: [guestReservationId], references: [id], onDelete: Cascade)
  bookingPayment   BookingPayment?   @relation(fields: [bookingPaymentId], references: [id])
  slots            BookingSlot[]

  @@index([userId, startsAt])
  @@index([guestReservationId, startsAt])
  @@index([hubId, startsAt])
  @@index([userId, status, endsAt])
  @@index([hubId, userId, status, endsAt])
  @@index([courtId, date])
  @@index([status, holdExpiresAt])
}

// Live occupancy of a single court-hour.
//
// The @@unique([courtId, date, hour]) below is the ONLY thing preventing a
// double-booking: two concurrent transactions inserting the same key block,
// then one fails with P2002, rolling back its whole Booking.
//
// IMPORTANT: these rows are DELETED when a booking is cancelled, so the hour
// becomes bookable again. Do not soft-delete them — Prisma cannot express a
// partial unique index (`WHERE status = 'CONFIRMED'`), so a lingering row
// would block that hour forever. The parent Booking survives as CANCELLED.
model BookingSlot {
  id        String  @id @default(cuid())
  bookingId String?
  eventId   String?
  blockId   String?
  courtId   String
  date      String
  hour      Int

  // A MIRROR of Booking.holdExpiresAt. Denormalized deliberately:
  //
  //   1. This is the hottest read in the app — every open slot grid polls it
  //      every 3 seconds — and the expiry predicate must be evaluable without
  //      joining Booking.
  //   2. It makes the reap in createBookingAction a plain
  //      DELETE ... WHERE courtId=? AND date=? AND hour IN (...) AND holdExpiresAt < now().
  //      As a relation subquery that becomes a lock-order hazard in the one
  //      transaction that must never deadlock.
  //
  // The invariant (slot.holdExpiresAt === booking.holdExpiresAt) is written in
  // exactly three transactional places: the claim in createBookingAction, the
  // confirm in settleBookingPayment, and the delete in expireBookingHolds.
  // Drift is self-healing anyway — a stale value only ever makes a row stop
  // blocking EARLIER, and the sweep deletes it.
  holdExpiresAt DateTime?

  booking Booking?    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  event   Event?      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  block   CourtBlock? @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([courtId, date, hour])
  @@index([bookingId])
  @@index([eventId])
  @@index([blockId])
  @@index([courtId, date])
  @@index([courtId, date, holdExpiresAt])
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum EventRegistrationStatus {
  PENDING
  CONFIRMED
  WAITLISTED
  CANCELLED
  EXPIRED
}

// A hub-hosted open play. Every selected court shares one Manila-local date
// and start/end window. Published events own BookingSlot rows, so a normal
// booking and an event can never claim the same court-hour concurrently.
model Event {
  id              String      @id @default(cuid())
  publicId        String      @unique
  hubId           String
  title           String
  description     String?     @db.Text
  sport           String
  date            String
  startHour       Int
  endHour         Int
  startsAt        DateTime
  endsAt          DateTime
  capacity        Int
  registrationFee Decimal     @db.Decimal(10, 2)
  status          EventStatus @default(DRAFT)
  publishedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  hub              Hub                   @relation(fields: [hubId], references: [id], onDelete: Cascade)
  courts           EventCourt[]
  slots            BookingSlot[]
  registrations    EventRegistration[]
  organizerGuests  EventOrganizerGuest[]
  chatConversation ChatConversation?
  openPlayQueue    OpenPlayQueue?

  @@index([hubId, startsAt])
  @@index([status, startsAt])
  @@index([hubId, status, endsAt])
}

// Messages has deliberately narrow room types. EVENT is one shared room for
// confirmed registrants, HUB_PLAYER is one reusable venue/player thread, and
// TRAINER_SESSION is one paid-session thread. Membership is always derived
// from the authoritative booking record at request time.
model ChatConversation {
  id               String               @id @default(cuid())
  kind             ChatConversationKind
  hubId            String?
  eventId          String?              @unique
  trainerSessionId String?              @unique
  playerId         String?
  lastMessageAt    DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  hub            Hub?            @relation(fields: [hubId], references: [id], onDelete: Cascade)
  event          Event?          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  trainerSession TrainerSession? @relation(fields: [trainerSessionId], references: [id], onDelete: Cascade)
  player         User?           @relation("ChatHubPlayer", fields: [playerId], references: [id], onDelete: SetNull)
  messages       ChatMessage[]
  readStates     ChatReadState[]

  @@unique([hubId, playerId])
  @@index([kind, lastMessageAt])
  @@index([playerId, lastMessageAt])
}

model ChatMessage {
  id             String          @id @default(cuid())
  conversationId String
  senderId       String?
  kind           ChatMessageKind @default(USER)
  body           String?         @db.VarChar(2000)
  systemType     String?         @db.VarChar(60)
  systemKey      String?         @unique @db.VarChar(160)
  targetPath     String?         @db.VarChar(500)
  clientNonce    String?         @db.VarChar(80)
  editedAt       DateTime?
  deletedAt      DateTime?
  // Scalar audit fact for both user and moderator deletion.
  deletedById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?            @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  reports      ChatReport[]

  @@unique([conversationId, senderId, clientNonce])
  @@index([conversationId, createdAt, id])
  @@index([senderId, createdAt])
}

model ChatReadState {
  conversationId String
  userId         String
  lastReadAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, lastReadAt])
}

model ChatBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("ChatBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("ChatBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model ChatReport {
  id           String             @id @default(cuid())
  messageId    String
  reporterId   String?
  category     ChatReportCategory
  details      String?            @db.VarChar(500)
  evidenceBody String?            @db.VarChar(2000)
  status       ChatReportStatus   @default(OPEN)
  reviewerId   String?
  resolution   String?            @db.VarChar(500)
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  message  ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter User?       @relation("ChatReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  @@unique([messageId, reporterId])
  @@index([status, createdAt])
  @@index([messageId])
}

model EventCourt {
  eventId String
  courtId String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@id([eventId, courtId])
  @@index([courtId])
}

// Stable BunalQ room. Event queues preserve registration/payment boundaries;
// Quick queues are immediate venue-operated rotations with public guest entry.
model OpenPlayQueue {
  id            String                @id @default(cuid())
  publicId      String                @unique
  hubId         String
  eventId       String?               @unique
  title         String                @db.VarChar(120)
  kind          OpenPlayQueueKind
  admissionMode OpenPlayAdmissionMode @default(APPROVAL_REQUIRED)
  createdById   String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  hub      Hub               @relation(fields: [hubId], references: [id], onDelete: Cascade)
  event    Event?            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessions OpenPlaySession[]

  @@index([hubId, updatedAt])
  @@index([kind, updatedAt])
}

// One immutable-history run inside a BunalQ room. Event and BookingSlot own
// scheduling; these rows only track attendance and live court rotation.
model OpenPlaySession {
  id                String                @id @default(cuid())
  queueId           String
  runNumber         Int                   @default(1)
  status            OpenPlaySessionStatus @default(SETUP)
  matchingMode      OpenPlayMatchingMode  @default(BALANCED)
  nextQueuePosition Int                   @default(0)
  createdById       String
  startedAt         DateTime?
  endedAt           DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  queue        OpenPlayQueue          @relation(fields: [queueId], references: [id], onDelete: Cascade)
  courts       OpenPlaySessionCourt[]
  participants OpenPlayParticipant[]
  pairs        OpenPlayPair[]
  games        OpenPlayGame[]

  @@unique([queueId, runNumber])
  @@index([queueId, status, updatedAt])
  @@index([status, updatedAt])
}

model OpenPlaySessionCourt {
  sessionId String
  courtId   String
  position  Int
  active    Boolean @default(true)

  session OpenPlaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  court   Court           @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@id([sessionId, courtId])
  @@unique([sessionId, position])
  @@index([courtId])
}

model OpenPlayPair {
  id        String   @id @default(cuid())
  sessionId String
  createdAt DateTime @default(now())

  session      OpenPlaySession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participants OpenPlayParticipant[]

  @@index([sessionId])
}

model OpenPlayParticipant {
  id                  String                    @id @default(cuid())
  sessionId           String
  source              OpenPlayParticipantSource
  userId              String?
  eventRegistrationId String?
  eventGuestSlotId    String?
  organizerGuestId    String?
  pairId              String?
  displayName         String                    @db.VarChar(120)
  skillLevel          String                    @default("intermediate") @db.VarChar(24)
  status              OpenPlayParticipantStatus @default(NOT_CHECKED_IN)
  lastResult          OpenPlayLastResult        @default(UNCLASSIFIED)
  queuePosition       Int?
  checkedInAt         DateTime?
  queuedAt            DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  session           OpenPlaySession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user              User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventRegistration EventRegistration?   @relation(fields: [eventRegistrationId], references: [id], onDelete: SetNull)
  eventGuestSlot    EventGuestSlot?      @relation(fields: [eventGuestSlotId], references: [id], onDelete: SetNull)
  organizerGuest    EventOrganizerGuest? @relation(fields: [organizerGuestId], references: [id], onDelete: SetNull)
  pair              OpenPlayPair?        @relation(fields: [pairId], references: [id], onDelete: SetNull)
  gameSlots         OpenPlayGamePlayer[]

  @@unique([sessionId, eventRegistrationId])
  @@unique([sessionId, eventGuestSlotId])
  @@unique([sessionId, organizerGuestId])
  @@index([sessionId, status, queuePosition])
  @@index([pairId])
  @@index([userId])
}

model OpenPlayGame {
  id              String                  @id @default(cuid())
  sessionId       String
  courtId         String
  sequence        Int
  matchingMode    OpenPlayMatchingMode
  selectionMethod OpenPlaySelectionMethod @default(AUTOMATIC)
  status          OpenPlayGameStatus      @default(STAGED)
  winningTeam     Int?
  createdById     String
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  session OpenPlaySession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  court   Court                @relation(fields: [courtId], references: [id], onDelete: Cascade)
  players OpenPlayGamePlayer[]

  @@unique([sessionId, sequence])
  @@index([sessionId, status, courtId])
  @@index([courtId, createdAt])
}

model OpenPlayGamePlayer {
  id                  String @id @default(cuid())
  gameId              String
  participantId       String
  team                Int
  slot                Int
  queuePositionBefore Int

  game        OpenPlayGame        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  participant OpenPlayParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([gameId, participantId])
  @@unique([gameId, slot])
  @@index([participantId])
}

// A registration always represents the signed-in lead player. Named guests
// live in EventGuestSlot so a lead can buy more capacity later without
// replacing or mutating the original successful payment.
model EventRegistration {
  id               String                  @id @default(cuid())
  eventId          String
  userId           String
  status           EventRegistrationStatus @default(PENDING)
  holdExpiresAt    DateTime?
  bookingPaymentId String?                 @unique
  confirmedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?                 @db.Text
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  event                Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment              BookingPayment?       @relation(fields: [bookingPaymentId], references: [id])
  guests               EventGuestSlot[]
  openPlayParticipants OpenPlayParticipant[]

  @@unique([eventId, userId])
  @@index([eventId, status, createdAt])
  @@index([userId, createdAt])
  @@index([userId, status, eventId])
}

// One capacity spot for a named guest. Initial guests share the lead player's
// BookingPayment; guests added after confirmation share a separate incremental
// payment. PENDING rows reserve capacity only while holdExpiresAt is live.
model EventGuestSlot {
  id                  String                  @id @default(cuid())
  eventRegistrationId String
  bookingPaymentId    String?
  name                String
  status              EventRegistrationStatus @default(PENDING)
  holdExpiresAt       DateTime?
  confirmedAt         DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  registration         EventRegistration     @relation(fields: [eventRegistrationId], references: [id], onDelete: Cascade)
  payment              BookingPayment?       @relation(fields: [bookingPaymentId], references: [id])
  openPlayParticipants OpenPlayParticipant[]

  @@index([eventRegistrationId, status, createdAt])
  @@index([bookingPaymentId])
  @@index([status, holdExpiresAt])
}

// A complimentary capacity spot created manually by the venue partner. It is
// deliberately separate from EventRegistration and EventGuestSlot: there is
// no player account, payment, or checkout associated with this spot. Paid
// events accrue a partner service-fee charge that is reversed on removal.
model EventOrganizerGuest {
  id          String                  @id @default(cuid())
  eventId     String
  createdById String
  name        String
  status      EventRegistrationStatus @default(CONFIRMED)
  confirmedAt DateTime                @default(now())
  cancelledAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  event                Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy            User                  @relation("OrganizerEventGuestCreator", fields: [createdById], references: [id], onDelete: Cascade)
  openPlayParticipants OpenPlayParticipant[]
  serviceFeeEntries    ServiceFeeEntry[]

  @@index([eventId, status, createdAt])
  @@index([createdById, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
